	local hl = Instance.new("Highlight"); hl.Name = "BNH_ESP"; hl.FillColor = color; hl.FillTransparency = 0.85; hl.OutlineColor = color; hl.Parent = inst
	track(bb); track(hl); espObjs[#espObjs+1] = bb; espObjs[#espObjs+1] = hl
end
local function refreshESP()
	clearESP()
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= lp and p.Character and espOn.players then
			tagESP(p.Character, p.Name, Color3.fromRGB(255,80,80))
		end
	end
	for _, m in pairs(workspace:GetChildren()) do
		if m:IsA("Model") then
			if espOn.mobs and table.find(mobNamesList, m.Name) then tagESP(m, m.Name, Color3.fromRGB(255,180,60)) end
			if espOn.mobs and table.find(bossNames, m.Name) then tagESP(m, "[BOSS] "..m.Name, Color3.fromRGB(200,60,255)) end
		end
	end
	if espOn.chests then
		local cs = workspace:FindFirstChild("ChestSpawns")
		if cs then for _, c in pairs(cs:GetDescendants()) do
			if c:IsA("BasePart") or c:IsA("Model") then tagESP(c, "Chest", Color3.fromRGB(255,230,80)) end
		end end
	end
	if espOn.bosses then
		local bt = workspace:FindFirstChild("BossRespawnTimers")
		if bt then for _, b in pairs(bt:GetChildren()) do
			local v = b:IsA("ValueBase") and b.Value or b:GetAttribute("TimeLeft") or b:GetAttribute("Time")
			local anchor = (b:IsA("PVInstance") and b) or b:FindFirstChildWhichIsA("BasePart", true)
				or workspace:FindFirstChild(b.Name, true)
			if anchor and anchor:IsA("PVInstance") then
				tagESP(anchor, "[BOSS] " .. b.Name .. (v and (" " .. tostring(v) .. "s") or ""), Color3.fromRGB(255,60,120))
			end
		end end
	end
end
