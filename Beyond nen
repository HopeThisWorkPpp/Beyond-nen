local function tagESP(inst, text, color)
	if not inst or not inst:IsA("PVInstance") then return end
	local bb = Instance.new("BillboardGui")
	bb.Name = "BNH_ESP"; bb.AlwaysOnTop = true; bb.Size = UDim2.fromOffset(120,40); bb.StudsOffset = Vector3.new(0,3,0)
	bb.Adornee = inst; bb.Parent = inst
	local t = Instance.new("TextLabel"); t.BackgroundTransparency = 1; t.Size = UDim2.fromScale(1,1)
