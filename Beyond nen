local function walkTo(pos, arrive, timeout)
	local h, r = hum(), hrp()
	if not (h and r) then return false end
	arrive, timeout = arrive or 6, timeout or 15
	local t0, lastPos, stuckT = os.clock(), r.Position, os.clock()
	local wp, wi = nil, 0
	local function repath()
		local rr = hrp(); if not rr then return false end
		local ok, path = pcall(function()
			return PathfindingService:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true})
		end)
		if not ok or not path then return false end
		pcall(function() path:ComputeAsync(rr.Position, pos) end)
		if path.Status ~= Enum.PathStatus.Success then return false end
		wp = path:GetWaypoints()
		wi = 1
		return #wp > 0
	end
	repath()
	while os.clock() - t0 < timeout do
		local rr = hrp(); if not (rr and h.Parent) then return false end
		local d = (rr.Position - pos).Magnitude
		if d <= arrive then return true end
		if d > 35 then examDash(pos) end
		local target = pos
		if wp and wi <= #wp then
			local w = wp[wi]
			target = w.Position
			if w.Action == Enum.PathWaypointAction.Jump then h.Jump = true end
			if (rr.Position - w.Position).Magnitude < 3 then wi = wi + 1 end
		end
		h:MoveTo(target)
		if (rr.Position - lastPos).Magnitude < 0.6 then
			if os.clock() - stuckT > 2.5 then
				if not repath() then h:MoveTo(pos) end
				if os.clock() - stuckT > 7 then return false end
			end
		else
			lastPos, stuckT = rr.Position, os.clock()
		end
		task.wait(0.15)
	end
	return false
end
