		if diana then
			moveTo(diana:GetPivot() + Vector3.new(0, 0, 3))
			task.wait(0.5)
			if dpp then pcall(function() firePP(dpp) end) task.wait(0.4) end
			callSvc("QuestsService", "get_quest", "StarterQuest", "yes")
			notify("StarterQuest Stage 3: Returned April to Diana.")
		else notify("Diana not found for stage 3.") end

	else
		-- Final stage — talk to Diana to complete
		local diana, dpp = findNPC("Diana")
		if diana and dpp then
			moveTo(diana:GetPivot() + Vector3.new(0, 0, 3))
			task.wait(0.4)
			pcall(function() firePP(dpp) end)
			task.wait(0.4)
			callSvc("QuestsService", "get_quest", "StarterQuest", "yes")
			notify("StarterQuest: Completed!")
		end
	end
end

