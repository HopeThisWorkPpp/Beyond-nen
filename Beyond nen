local function httpGet(url)
	for _, f in ipairs({
		function() return game:HttpGet(url) end,
		function() return httpget and httpget(url) end,
		function() local r = request and request({Url = url, Method = "GET"}) return r and r.Body end,
		function() local r = http_request and http_request({Url = url, Method = "GET"}) return r and r.Body end,
	}) do
		local ok, res = pcall(f)
		if ok and type(res) == "string" and #res > 0 then return res end
	end
end

local function isLibSource(s)
	return type(s) == "string"
		and s:find("MythiOs UI Library", 1, true)
		and s:find("api:Toggle", 1, true)
		and s:find("return Library", 1, true)
		and not s:find("premium", 1, true)
		and not s:find("freemium", 1, true)
		and not s:find("loadstring", 1, true)
end

