					if num and need[num] then
						farmHold = true
						local ok = pcall(doNodeMaster)
						farmHold = false
						notify("Node Sniper: master #" .. num .. " visited (" .. tostring(ok) .. ")")
						task.wait(1.5)
						sniperHop(st)
					elseif workspace:GetAttribute("MasterSpawned") ~= true then
						task.wait(6)
						if workspace:GetAttribute("MasterSpawned") ~= true then sniperHop(st) end
					else
						sniperHop(st)
					end
				end
			else
				task.wait(3)
			end
			task.wait(1)
		end
	end)
end

