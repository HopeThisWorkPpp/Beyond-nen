		if missionDoor then
			moveTo(CFrame.new(missionDoor:IsA("BasePart") and missionDoor.Position or missionDoor:GetPivot().Position) + Vector3.new(0, 3, 2))
			task.wait(0.5)
		end

		-- Walk through objectives — game tracks DianaRescueStep attribute
		-- We just fire get_quest with yes and wait for InMission to trigger
		if lp:GetAttribute("InMission") ~= true then
			callSvc("QuestsService", "get_quest", "StarterQuest", "yes")
			task.wait(1)
		end

