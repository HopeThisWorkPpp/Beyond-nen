		local world = workspace:FindFirstChild("World")
		local missionDoor = world and world:FindFirstChild("Rooms")
		missionDoor = missionDoor and missionDoor:FindFirstChild("Entries")
		missionDoor = missionDoor and missionDoor:FindFirstChild("DianaMission")
