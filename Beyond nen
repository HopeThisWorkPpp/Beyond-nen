local function destroy()
	dead = true
	farmMob = nil
	local c = char()
	if c then for _,p in pairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = true end end end
	for _,c in pairs(connections) do pcall(function() c:Disconnect() end) end
	for _,c in pairs(watched) do pcall(function() c:Disconnect() end) end
	for _,i in pairs(injected) do pcall(function() i:Destroy() end) end
	setAntiAFK(false); clearESP(); setFB(false)
	pcall(function() if window.Destroy then window:Destroy() end end)
end
ENV["Zentynal Hub"] = {Destroy = destroy, Window = window}
ENV.BNH = {
	set = function(k, v)
		local map = {autoExamOn=function() autoExamOn=v end, farmOn=function() farmOn=v auraOn=v end,
			mineOn=function() mineOn=v end, medOn=function() medOn=v end, bossOn=function() bossOn=v end,
			autoQuest=function() autoQuest=v end, examFightMobs=function() examFightMobs=v end}
		if map[k] then map[k]() end
	end,
	get = function(k)
		local map = {autoExamOn=autoExamOn, farmOn=farmOn, mineOn=mineOn, medOn=medOn,
			bossOn=bossOn, autoQuest=autoQuest, examFightMobs=examFightMobs, combatMod=(combatMod~=nil)}
		return map[k]
	end,
	call = function(name, ...)
		local fns = {walkTo=walkTo, fightMob=fightMob, examGetup=examGetup, getCombat=getCombat,
			findInstructor=findInstructor, myPlot=myPlot, examAttack=examAttack}
		local f = fns[name]
		if f then return f(...) end
	end,
}
