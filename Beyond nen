		end
	end
	local qb = w and w:FindFirstChild("Quest Boards")
	for _, c in pairs(qb and qb:GetChildren() or {}) do
		local n = "Board: " .. c.Name
		locLookup[n] = c
		locNames[#locNames + 1] = n
