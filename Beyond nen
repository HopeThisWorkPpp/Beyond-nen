	end

	if not stage then notify("StarterQuest could not be accepted.") return end
	notify("StarterQuest — Stage " .. stage)

	if stage == 1 then
		-- Talk to Diana at port
		local m, pp = findNPC("Diana")
		if m and pp then
			moveTo(m:GetPivot() + Vector3.new(0, 0, 3))
			task.wait(0.4)
			pcall(function() firePP(pp) end)
			task.wait(0.5)
