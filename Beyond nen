-- ============================================================

-- NPC → BoardId map (from Kato_5939 + dump structure)
local SB_NPC_MAP = {
	Sarah   = "WhaleIslandTown",
	Zeal    = "CrimsonCamp",
	Roger   = "Farm",
	Nora    = "BlickCastle",
	Jacob   = "Mines",
	Kato    = "WhaleIslandBeach",
	Lily    = "DeepForest",
	Victor  = "Swamp",
	Florence= "VolcanicArea",
}

-- Find any NPC model by name anywhere in World
local function findNPC(name)
	local world = workspace:FindFirstChild("World")
	local root = world or workspace
	for _, m in pairs(root:GetDescendants()) do
		if m:IsA("Model") and m.Name == name then
			local pp = m:FindFirstChildWhichIsA("ProximityPrompt", true)
			if pp then return m, pp end
		end
	end
end

-- Unlock the storyline board by talking to the NPC gatekeeper
local function unlockStorylineBoard(boardId)
	local npcName
	for n, b in pairs(SB_NPC_MAP) do
		if b == boardId then npcName = n break end
	end
	if not npcName then notify("No NPC found for board: " .. boardId) return false end

	local state = lp:GetAttribute("SB_" .. boardId)
	if state and state ~= "Intro" then
		notify(boardId .. " board already unlocked (state: " .. tostring(state) .. ")")
		return true
	end

	local m, pp = findNPC(npcName)
	if not (m and pp) then notify(npcName .. " NPC not found.") return false end

	notify("Talking to " .. npcName .. " to unlock " .. boardId .. " board...")
	moveTo(m:GetPivot() + Vector3.new(0, 0, 3))
	task.wait(0.4)
	pcall(function() firePP(pp) end)
	task.wait(0.5)
	-- The game fires StorylineBoardService:unlock() client-side via the NPC dialog
	-- We replicate by calling the service directly
	local ok = callSvc("StorylineBoardService", "unlock", boardId)
	task.wait(0.8)

	local newState = lp:GetAttribute("SB_" .. boardId)
	if newState and newState ~= "Intro" then
		notify(boardId .. " board unlocked!")
		return true
	end
	notify("Talked to " .. npcName .. " — board may need dialog steps.")
	return false
end

-- Claim storyline board reward after completing all quests
local function claimStorylineBoard(boardId)
	local npcName
	for n, b in pairs(SB_NPC_MAP) do
		if b == boardId then npcName = n break end
	end
	if not npcName then return false end

	local m, pp = findNPC(npcName)
	if not (m and pp) then notify(npcName .. " not found for claim.") return false end

	notify("Claiming " .. boardId .. " board reward from " .. npcName .. "...")
	moveTo(m:GetPivot() + Vector3.new(0, 0, 3))
	task.wait(0.4)
	pcall(function() firePP(pp) end)
	task.wait(0.5)
	callSvc("StorylineBoardService", "claim", boardId)
	task.wait(0.5)
	notify(boardId .. " board claimed!")
	return true
end

-- Auto-complete all quests on a board then claim
local autoBoardOn = false
local autoBoardTarget = "WhaleIslandBeach"
local autoBoardBusy = false

task.spawn(function()
	while not dead do
		if autoBoardOn and not autoBoardBusy then
			autoBoardBusy = true
			local boardId = autoBoardTarget

			-- Step 1: unlock if needed
			local state = lp:GetAttribute("SB_" .. boardId)
			if not state or state == "Intro" then
				unlockStorylineBoard(boardId)
				task.wait(2)
				state = lp:GetAttribute("SB_" .. boardId)
			end

			if state == "Unlocked" or state == nil then
				-- Step 2: scan board for quests
				if not next(boardCache) then scanBoards() end
				local boardName = BOARDS[boardId] and BOARDS[boardId].name
				local bd = boardName and boardCache[boardName]

				if bd then
					for _, qid in ipairs(bd.quests) do
						if not autoBoardOn then break end
						local aq = activeQuests()
						local q = aq and aq:FindFirstChild(qid)
						if not q then
							acceptQuest(qid)
							task.wait(1)
						end

						-- farm kill quest if applicable
						local mob = questMob(qid)
						if mob then
							farmTarget = mob
							if C.farmTarget then C.farmTarget:Set(mob) end
							farmOn = true
							auraOn = true
							if C.aura then C.aura:Set(true) end

							-- wait until quest complete
							local timeout = tick() + 300
							while autoBoardOn and tick() < timeout do
								local aq2 = activeQuests()
								local q2 = aq2 and aq2:FindFirstChild(qid)
								if q2 then
									callSvc("QuestsService", "collect", qid)
									task.wait(1)
									local aq3 = activeQuests()
									if not (aq3 and aq3:FindFirstChild(qid)) then
										notify(qid .. " done!")
										break
									end
								else
									break
								end
								task.wait(3)
							end
							farmOn = false
						end
					end
				end
			end

			-- Step 3: check if claimable
			local finalState = lp:GetAttribute("SB_" .. boardId)
			if finalState == "Complete" then
				claimStorylineBoard(boardId)
			end

			autoBoardBusy = false
		end
		task.wait(3)
	end
end)

