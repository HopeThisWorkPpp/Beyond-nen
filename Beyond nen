local function mobNames()
	local players = {}
	for _, p in pairs(game.Players:GetPlayers()) do players[p.Name] = true end
	local seen, names = {}, {}
	local function add(n)
		if type(n) == "string" and n ~= "" and not seen[n] and not players[n] then
			seen[n] = true names[#names + 1] = n
		end
	end
	for _, m in pairs(workspace:GetChildren()) do
		if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") then add(m.Name) end
	end
	for _, fn in ipairs({"RoamingNpcs", "NpcZones", "Humanoids", "NpcSpawnPoints", "KillSpawnAnchors"}) do
		local f = workspace:FindFirstChild(fn) or RS:FindFirstChild(fn)
		if f then
			for _, c in pairs(f:GetDescendants()) do
				if c:IsA("Model") and c:FindFirstChildOfClass("Humanoid") then add(c.Name) end
			end
			for _, c in pairs(f:GetChildren()) do add(c.Name) end
		end
	end
	local nsp = RS:FindFirstChild("NpcSpawnPoints")
	if nsp then for _, c in pairs(nsp:GetChildren()) do add(c.Name) end end
	table.sort(names)
	return names
end

