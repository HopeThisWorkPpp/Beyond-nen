-- STORY QUEST AUTO-CHAIN
-- One toggle that runs all undone story quests in sequence.
-- ============================================================

local storyQuestOn = false
local storyQuestBusy = false

-- Check if a story quest has been permanently completed (can_only_be_done_once flag)
local function isStoryQuestDone(qid)
	-- The game sets a player attribute like "CompletedQuests" or stores them in Done folder
	-- Check both common patterns
	local d = lp:FindFirstChild("Data")
	local ss = d and d:FindFirstChild("SavesSlot")
	local slot = ss and ss:FindFirstChild(tostring(lp:GetAttribute("SelectedSlot") or 1))
	local pd = slot and slot:FindFirstChild("PlayerData")
	if pd then
		local done = pd:FindFirstChild("CompletedQuests") or pd:FindFirstChild("DoneQuests")
		if done and done:FindFirstChild(qid) then return true end
		-- Also check attributes on PlayerData
		if pd:GetAttribute(qid) == true then return true end
	end
	-- Also check lp attributes
	if lp:GetAttribute(qid .. "_done") == true then return true end
	if lp:GetAttribute(qid) == true and qid ~= "StarterQuest" then return true end
	return false
end

-- Wait for a quest to become active with timeout
local function waitForQuestActive(qid, timeout)
	timeout = timeout or 10
	local t0 = tick()
	while tick() - t0 < timeout do
		if isQuestActive(qid) then return true end
		task.wait(0.5)
	end
	return false
end

-- Wait for quest stage to advance
local function waitForQuestStage(qid, targetStage, timeout)
	timeout = timeout or 60
	local t0 = tick()
	while tick() - t0 < timeout do
		local _, stage = getQuestStage(qid)
		if stage >= targetStage then return true end
		if not isQuestActive(qid) then return false end
		task.wait(0.5)
	end
	return false
end

-- Wait for quest to leave active (completed)
local function waitForQuestGone(qid, timeout)
	timeout = timeout or 30
	local t0 = tick()
	while tick() - t0 < timeout do
		if not isQuestActive(qid) then return true end
		task.wait(0.5)
	end
	return false
end

-- Kill farming helper for story quest chains
local function farmUntilQuestStageAdvances(qid, fromStage, mobName, timeout)
	timeout = timeout or 120
	local t0 = tick()
	local prevFarmTarget = farmTarget
	local prevFarmOn = farmOn
	local prevAuraOn = auraOn
	farmTarget = mobName
	farmOn = true
	auraOn = true
	if C.farmTarget then pcall(function() C.farmTarget:Set(mobName) end) end
	if C.farm then pcall(function() C.farm:Set(true) end) end
	if C.aura then pcall(function() C.aura:Set(true) end) end

	while tick() - t0 < timeout and storyQuestOn do
		local _, stage = getQuestStage(qid)
		if not isQuestActive(qid) then break end
		if stage and stage > fromStage then break end
		-- Try collect
		pcall(function() callSvc("QuestsService", "collect", qid) end)
		task.wait(2)
	end

	farmOn = prevFarmOn
	auraOn = prevAuraOn
	farmTarget = prevFarmTarget
	if C.farmTarget then pcall(function() C.farmTarget:Set(prevFarmTarget) end) end
	if C.farm then pcall(function() C.farm:Set(prevFarmOn) end) end
	if C.aura then pcall(function() C.aura:Set(prevAuraOn) end) end
end

