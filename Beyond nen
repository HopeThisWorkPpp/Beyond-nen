local CFG_LAST = CFG_DIR .. "/_last.txt"
local curConfig = "default"
local function cfgPath(n) return CFG_DIR .. "/" .. n .. ".json" end
local function cfgNameOk(n)
	return type(n) == "string" and n ~= "" and not n:find("[/\\]") and n ~= "_last"
end
local function listConfigs()
	local out = {}
	if isFn(listfiles) and isFn(isfolder) and isfolder(CFG_DIR) then
		for _, p in pairs(listfiles(CFG_DIR)) do
			local n = p:gsub("\\", "/"):match("([^/]+)%.json$")
			if n and n ~= "_last" then out[#out + 1] = n end
		end
	end
	table.sort(out)
	if #out == 0 then out = {"default"} end
	return out
end
local function markLast(n)
	if isFn(makefolder) then pcall(makefolder, CFG_DIR) end
	if isFn(writefile) then pcall(writefile, CFG_LAST, n) end
end
local function saveConfig(name)
	name = cfgNameOk(name) and name or curConfig
	local data = {
		farmOn=farmOn, farmTarget=farmTarget, farmPos=farmPos, farmDist=farmDist, farmYOff=farmYOff, farmFloat=farmFloat,
		auraOn=auraOn, parryOn=parryOn, parryRange=parryRange, parryDelay=parryDelay,
		skillOn=skillOn, gripOn=gripOn, autoWeapon=autoWeapon, weaponChoice=weaponChoice,
		autoQuest=autoQuest, questId=questId, chestOn=chestOn, alertOn=alertOn,
		wsOn=wsOn, wsVal=wsVal, talentOn=talentOn, talentReroll=talentReroll, talentMin=talentMin,
		espOn=espOn, mineOn=mineOn, fishOn=fishOn, medOn=medOn, antiAFK=(afkConn ~= nil),
		autoStatsOn=autoStatsOn, statChoice=statChoice, nodeMasterOn=nodeMasterOn, sniperOn=sniperOn,
		minePri1=minePri1, minePri2=minePri2, autoSellOn=autoSellOn,
		bossOn=bossOn, bossEnabled=bossEnabled,
		autoExamOn=autoExamOn, examFightMobs=examFightMobs, examSpeed=examSpeed,
	}
	local ok, j = pcall(function() return HttpService:JSONEncode(data) end)
	if ok and isFn(writefile) then
		if isFn(makefolder) then pcall(makefolder, CFG_DIR) end
		writefile(cfgPath(name), j)
		curConfig = name
		markLast(name)
	end
end
local CFG_MAP = {
	farmOn="farm", farmTarget="farmTarget", farmPos="farmPos", farmDist="farmDist",
	farmYOff="farmYOff", farmFloat="farmFloat", auraOn="aura", parryOn="parry",
	parryRange="parryRange", skillOn="skills", gripOn="grip", autoWeapon="autoWeapon",
	autoQuest="autoQuest", chestOn="chests", alertOn="alert", wsOn="ws", wsVal="wsVal",
	talentOn="talentAuto", talentReroll="talentReroll", talentMin="talentMin",
	mineOn="mine", fishOn="fish", medOn="meditate", antiAFK="antiAFK",
	autoStatsOn="autoStats", statChoice="statChoice", nodeMasterOn="nodeMaster", sniperOn="sniper",
	minePri1="minePri1", minePri2="minePri2", autoSellOn="autoSell", bossOn="boss",
	autoExamOn="exam", examFightMobs="examFight", examSpeed="examSpeed",
}
local function loadConfig(name)
	name = cfgNameOk(name) and name or curConfig
	if not (isFn(isfile) and isfile(cfgPath(name))) then notify("No config: " .. name) return end
	local ok, d = pcall(function() return isFn(readfile) and HttpService:JSONDecode(readfile(cfgPath(name))) end)
	if not (ok and type(d) == "table") then return end
	curConfig = name
	markLast(name)
	task.delay(0.8, function()
		for k, v in pairs(d) do
			if k == "espOn" and type(v) == "table" then
				for n, on in pairs(v) do
					local c = C["esp_" .. n]
					if c then c:Set(on) else espOn[n] = on end
				end
			elseif k == "bossEnabled" and type(v) == "table" then
				for n, on in pairs(v) do
					local c = C["boss_" .. n]
					if c then c:Set(on) else bossEnabled[n] = on end
				end
			elseif k == "parryDelay" then
				parryDelay = v
				if C.parryDelay then C.parryDelay:Set(v * 100) end
			elseif k == "questId" then
				questId = v
				if C.quest and QUEST_BY_ID[v] then C.quest:Set(QUEST_BY_ID[v]) end
			elseif k == "weaponChoice" then
				weaponChoice = v
				if C.weapon and C.weaponByName then
					for lbl, w in pairs(C.weaponByName) do if w.name == v then C.weapon:Set(lbl) break end end
				end
			else
				local ck = CFG_MAP[k]
				if ck and C[ck] then C[ck]:Set(v) end
			end
		end
		notify("Config loaded: " .. name)
	end)
end
task.delay(1, function()
	local last = isFn(isfile) and isfile(CFG_LAST) and isFn(readfile) and readfile(CFG_LAST) or nil
	if cfgNameOk(last) and isfile(cfgPath(last)) then
		loadConfig(last)
	elseif isfile(cfgPath("default")) then
		loadConfig("default")
	end
end)
