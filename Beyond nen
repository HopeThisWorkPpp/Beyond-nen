		Text = "Join the community",
		TextColor3 = Theme.text,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 9002,
	}, card)

	mk("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, 108),
		Size = UDim2.new(1, -40, 0, 44),
		Font = Enum.Font.Gotham,
		Text = "We drop updates, sneak peeks, and support here first. Hop in so you don't miss anything.",
		TextColor3 = Theme.textDim,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 9002,
	}, card)

	local copyBtn = mk("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = Theme.accentDim,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(20, 164),
		Size = UDim2.new(0.5, -26, 0, 36),
		Font = Enum.Font.GothamBold,
		Text = "Copy invite link",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextSize = 12,
		ZIndex = 9002,
	}, card)
	corner(copyBtn, 8)
	stroke(copyBtn, Theme.accent, 1, 0.1)
	hoverScale(copyBtn, 1.02)

	local closeBtn = mk("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = Theme.panelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0.5, 6, 0, 164),
		Size = UDim2.new(0.5, -26, 0, 36),
		Font = Enum.Font.GothamBold,
		Text = "Close (5)",
		TextColor3 = Theme.textDim,
		TextSize = 12,
		ZIndex = 9002,
	}, card)
	corner(closeBtn, 8)
	stroke(closeBtn, Theme.stroke, 1, 0.4)

	local copied = false
	local function setCopied()
		copied = true
		copyBtn.Text = "Copied!"
		copyBtn.BackgroundColor3 = Theme.accent
		task.delay(1.6, function()
			if copyBtn and copyBtn.Parent then
				copyBtn.Text = "Copy invite link"
				copyBtn.BackgroundColor3 = Theme.accentDim
			end
		end)
	end

	local function doCopy()
		pcall(function()
			if typeof(setclipboard) == "function" then
				setclipboard(PROMO_LINK)
				return
			end
			if typeof(toclipboard) == "function" then
				toclipboard(PROMO_LINK)
				return
			end
			if typeof(writeclipboard) == "function" then
				writeclipboard(PROMO_LINK)
				return
			end
		end)
		setCopied()
	end

	copyBtn.MouseButton1Click:Connect(function()
		pressPunch(copyBtn)
		doCopy()
	end)

	local canClose = false
	local remaining = PROMO_COOLDOWN
	local function tick()
		remaining -= 1
		if remaining > 0 then
			closeBtn.Text = string.format("Close (%d)", remaining)
		else
			canClose = true
			closeBtn.Text = "Close"
			closeBtn.TextColor3 = Theme.text
			tween(closeBtn, { BackgroundColor3 = Theme.panelAlt }, 0.16)
			stroke(closeBtn, Theme.strokeHi, 1, 0.2)
		end
	end
	task.spawn(function()
		task.wait(1)
		while remaining > 0 do
			tick()
			task.wait(1)
		end
	end)

	local function dismiss()
		if not canClose then return end
		safeMkDir("Zentynal")
		safeWriteFile(PROMO_FILE, tostring(os.time()))
		tween(overlay, { BackgroundTransparency = 1 }, 0.2)
		tween(card, { BackgroundTransparency = 1 }, 0.2)
		task.wait(0.24)
		if overlay and overlay.Parent then overlay:Destroy() end
	end

	closeBtn.MouseButton1Click:Connect(function()
		if not canClose then return end
		pressPunch(closeBtn)
		dismiss()
	end)

	overlay.BackgroundTransparency = 1
	tween(overlay, { BackgroundTransparency = 0.5 }, 0.24)
	card.Size = UDim2.fromOffset(340, 210)
	tween(card, { Size = UDim2.fromOffset(380, 240) }, 0.3, Enum.EasingStyle.Back)

	return overlay
end

-- ── Window ───────────────────────────────────────────────────────────────
function Library.CreateWindow(opts)
	opts = opts or {}
	local title = tostring(opts.Title or LIB_NAME)
	if title == "" then title = LIB_NAME end
	local subtitle = tostring(opts.Subtitle or "")
	local compact = isCompact()
	local size = opts.Size or UDim2.fromOffset(840, 560)
	do
		local vs = viewportSize()
		local insetY = 0
		pcall(function() insetY = GuiService:GetGuiInset().Y end)
		local maxW = math.max(300, vs.X - (compact and 12 or 28))
		local maxH = math.max(260, vs.Y - (compact and 16 or 32) - insetY * 0.2)
		local wantW, wantH = size.X.Offset, size.Y.Offset
		if wantW <= 0 then wantW = 840 end
		if wantH <= 0 then wantH = 560 end
		size = UDim2.fromOffset(math.floor(math.min(wantW, maxW)), math.floor(math.min(wantH, maxH)))
	end

	local toggleKeys = {}
	local function addToggleKey(key)
		if typeof(key) == "string" then key = Enum.KeyCode[key] end
		if typeof(key) == "EnumItem" then
			for _, existing in ipairs(toggleKeys) do
				if existing == key then return end
			end
			table.insert(toggleKeys, key)
		end
	end
	if opts.ToggleKeys then
		for _, key in ipairs(opts.ToggleKeys) do addToggleKey(key) end
	end
	addToggleKey(opts.ToggleKey)
	if #toggleKeys == 0 then addToggleKey(Enum.KeyCode.RightShift) end

	local screenParent = parentGui()
	local screen = mk("ScreenGui", {
		Name = LIB_NAME .. "Window",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = opts.DisplayOrder or 120000,
		IgnoreGuiInset = true,
		Enabled = true,
	}, screenParent)

	makeShadow(screen, size, 8)

	local root = mk("Frame", {
		Name = "Root",
		BackgroundColor3 = Theme.bg,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = size,
		ClipsDescendants = true,
		Visible = false,
		Active = true,
		ZIndex = 10,
	}, screen)
	corner(root, 12)
	mk("UIGradient", { Color = ColorSequence.new(Theme.bg, Theme.bgHi), Rotation = 45 }, root)
	stroke(root, Theme.strokeHi, 1, 0.55)

	local topLine = mk("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = Theme.accent,
		BorderSizePixel = 0,
		ZIndex = 11,
	}, root)
	mk("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.accentDim),
			ColorSequenceKeypoint.new(0.5, Theme.accent),
			ColorSequenceKeypoint.new(1, Theme.cyan),
		}),
	}, topLine)

	local openScale = mk("UIScale", { Name = "OpenScale", Scale = 1 }, root)
	local body = mk("Frame", { Name = "BodyRow", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 20 }, root)

	local SIDE_W = compact and 148 or 200
	local sidebar = mk("Frame", {
		Name = "Sidebar",
		BackgroundColor3 = Theme.sidebar,
		BorderSizePixel = 0,
		Size = UDim2.new(0, SIDE_W, 1, 0),
		ClipsDescendants = true,
	}, body)
	mk("UIGradient", { Color = ColorSequence.new(Theme.sidebar, Theme.sidebarHi), Rotation = 90 }, sidebar)

