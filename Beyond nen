local function findBoard(qid)
	local world = workspace:FindFirstChild("World")
	local root = (world and world:FindFirstChild("Quest Boards")) or workspace
	for _, d in pairs(root:GetDescendants()) do
		if d:GetAttribute("Quest") == qid then
			local b = d:FindFirstAncestorOfClass("Model")
			local pp = b and (b:FindFirstChild("Interactor", true) or b):FindFirstChildWhichIsA("ProximityPrompt", true)
			if b and pp then return b, pp end
		end
	end
end
local function acceptQuest(qid)
	local board, pp = findBoard(qid)
	if not (board and pp) then return false end
	questBusy = true
	local c = char()
	local bp = pp.Parent:IsA("BasePart") and pp.Parent.Position or board:GetPivot().Position
	for i = 1, 4 do
		if c and c.Parent then c:PivotTo(CFrame.new(bp + Vector3.new(0, 0, 4))) end
		task.wait(0.25)
	end
	local h = hrp()
	if not (h and (h.Position - bp).Magnitude <= 15) then
		questBusy = false
		return false
	end
	pcall(function() firePP(pp) end)
	for _, d in pairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.ActionText == "Interact" then
			local p = d.Parent and (d.Parent:IsA("BasePart") and d.Parent.Position
				or d.Parent:IsA("Model") and d.Parent:GetPivot().Position)
			if p and (p - bp).Magnitude <= 40 then
				pcall(function() firePP(d) end)
			end
		end
	end
	task.wait(0.9)
	callSvc("QuestsService", "set_board_viewing", true)
	task.wait(0.3)
	local function hasChild()
		local aq = activeQuests()
		return aq and aq:FindFirstChild(qid) ~= nil
	end
	if lp:GetAttribute(qid) == true then
		callSvc("QuestsService", "repeat_quest", qid)
	else
		callSvc("QuestsService", "get_quest", qid, "yes")
	end
	task.wait(0.9)
	if not hasChild() then
		if lp:GetAttribute(qid) == true then
			callSvc("QuestsService", "get_quest", qid, "yes")
		else
			callSvc("QuestsService", "repeat_quest", qid)
		end
		task.wait(0.9)
	end
	callSvc("QuestsService", "set_board_viewing", false)
	local ok = hasChild()
	questBusy = false
	return ok
end
